# Groq (free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# Neon Postgres connection string (free tier)
DATABASE_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=any-long-random-string
# Leave empty on first run: the bot will reply with your chat id, then paste it here
ALLOWED_CHAT_ID=

# Dashboard login (username: anything)
DASHBOARD_PASSWORD=change-me
TZ_NAME=Asia/Phnom_Penh
